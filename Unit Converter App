enum ConverterType { length, weight, temperature }

List<String> getUnits(ConverterType type) {
  switch (type) {
    case ConverterType.length:
      return ['Meter', 'Kilometer', 'Centimeter', 'Mile'];
    case ConverterType.weight:
      return ['Kilogram', 'Gram', 'Pound'];
    case ConverterType.temperature:
      return ['Celsius', 'Fahrenheit', 'Kelvin'];
  }
}

// Convert input into a common base unit and then to target unit.
double convertValue(double value, String from, String to, ConverterType type) {
  if (from == to) return value;

  double base;

  switch (type) {
    case ConverterType.length:
      switch (from) {
        case 'Kilometer':
          base = value * 1000;
          break;
        case 'Centimeter':
          base = value / 100;
          break;
        case 'Mile':
          base = value * 1609.344;
          break;
        default:
          base = value;
      }

      switch (to) {
        case 'Kilometer':
          return base / 1000;
        case 'Centimeter':
          return base * 100;
        case 'Mile':
          return base / 1609.344;
        default:
          return base;
      }

    case ConverterType.weight:
      switch (from) {
        case 'Gram':
          base = value / 1000;
          break;
        case 'Pound':
          base = value * 0.45359237;
          break;
        default:
          base = value;
      }

      switch (to) {
        case 'Gram':
          return base * 1000;
        case 'Pound':
          return base / 0.45359237;
        default:
          return base;
      }

    case ConverterType.temperature:
      // Convert to Celsius first.
      switch (from) {
        case 'Fahrenheit':
          base = (value - 32) * 5 / 9;
          break;
        case 'Kelvin':
          base = value - 273.15;
          break;
        default:
          base = value;
      }

      switch (to) {
        case 'Fahrenheit':
          return base * 9 / 5 + 32;
        case 'Kelvin':
          return base + 273.15;
        default:
          return base;
      }
  }
}

