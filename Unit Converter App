// SHARED CONVERTER SCREEN
class ConverterScreen extends StatefulWidget {
  final ConverterType type;

  const ConverterScreen({super.key, required this.type});

  @override
  State<ConverterScreen> createState() => _ConverterScreenState();
}

class _ConverterScreenState extends State<ConverterScreen> {
  final TextEditingController controller = TextEditingController(text: '1');

  late String fromUnit;
  late String toUnit;

  double result = 1;

  @override
  void initState() {
    super.initState();
    fromUnit = getUnits(widget.type)[0];
    toUnit = getUnits(widget.type)[1];
    calculate();
  }

  void calculate() {
    double value = double.tryParse(controller.text) ?? 0;

    setState(() {
      result = convertValue(value, fromUnit, toUnit, widget.type);
    });
  }

  @override
  void dispose() {
    controller.dispose();
    super.dispose();
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(
        title: Text('${widget.type.name.toUpperCase()} CONVERTER'),
        backgroundColor: Colors.deepPurple,
        foregroundColor: Colors.white,
      ),
      body: Padding(
        padding: const EdgeInsets.all(20),
        child: Column(
          children: [
            const SizedBox(height: 25),

            TextField(
              controller: controller,
              keyboardType: const TextInputType.numberWithOptions(
                decimal: true,
                signed: true,
              ),
              decoration: const InputDecoration(
                labelText: 'Enter Value',
                border: OutlineInputBorder(),
              ),
              onChanged: (_) => calculate(),
            ),

            const SizedBox(height: 25),

            const Align(
              alignment: Alignment.centerLeft,
              child: Text('From Unit'),
            ),

            DropdownButtonFormField<String>(
              value: fromUnit,
              decoration: const InputDecoration(border: OutlineInputBorder()),
              items: getUnits(widget.type).map((unit) {
                return DropdownMenuItem(value: unit, child: Text(unit));
              }).toList(),
              onChanged: (value) {
                if (value != null) {
                  setState(() {
                    fromUnit = value;
                    calculate();
                  });
                }
              },
            ),

            const SizedBox(height: 20),

            const Align(
              alignment: Alignment.centerLeft,
              child: Text('To Unit'),
            ),

            DropdownButtonFormField<String>(
              value: toUnit,
              decoration: const InputDecoration(border: OutlineInputBorder()),
              items: getUnits(widget.type).map((unit) {
                return DropdownMenuItem(value: unit, child: Text(unit));
              }).toList(),
              onChanged: (value) {
                if (value != null) {
                  setState(() {
                    toUnit = value;
                    calculate();
                  });
                }
              },
            ),

            const SizedBox(height: 35),

            Container(
              width: double.infinity,
              padding: const EdgeInsets.all(25),
              decoration: BoxDecoration(
                color: Colors.deepPurple,
                borderRadius: BorderRadius.circular(15),
              ),
              child: Column(
                children: [
                  const Text(
                    'Converted Result',
                    style: TextStyle(color: Colors.white70, fontSize: 18),
                  ),
                  const SizedBox(height: 12),
                  Text(
                    result.toStringAsFixed(4),
                    style: const TextStyle(
                      color: Colors.white,
                      fontSize: 30,
                      fontWeight: FontWeight.bold,
                    ),
                  ),
                  Text(toUnit, style: const TextStyle(color: Colors.white)),
                ],
              ),
            ),

            const SizedBox(height: 25),

            ElevatedButton.icon(
              onPressed: () => Navigator.pop(context),
              icon: const Icon(Icons.arrow_back),
              label: const Text('Back to Home'),
            ),
          ],
        ),
      ),
    );
  }
}

double convertLength(double value, String from, String to) {
  if (from == to) {
    return value;
  }

  if (from == 'Meters' && to == 'Kilometers') {
    return value / 1000;
  }

  if (from == 'Kilometers' && to == 'Meters') {
    return value * 1000;
  }

  return value;
}
